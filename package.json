{
  "name": "unfancy-money-tracker",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:all": "./scripts/start-all.sh",
    "android": "./scripts/android-dev.sh",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:integration": "vitest run --run src/platform/persistence/persistence.test.ts src/platform/exchange-rates/httpExchangeRateProvider.test.ts && vitest run --config vitest.integration.config.ts",
    "test:fixtures": "vitest run src/features/development/mockData.test.ts",
    "test:infra": "vitest run --config vitest.integration.config.ts infra",
    "test:contract": "sam validate --template sam/template.yaml --lint && pnpm run db:build-migrations && pnpm run test:infra && pnpm run infra:synth:dev && pnpm run infra:synth:prod",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify:web:deployment": "./scripts/verify-web-deployment.sh",
    "local:start": "./scripts/local-env.sh start",
    "local:stop": "./scripts/local-env.sh stop",
    "local:reset": "./scripts/local-env.sh reset",
    "local:init": "./scripts/local-env.sh init",
    "local:seed": "./scripts/local-env.sh seed",
    "local:seed-app": "./scripts/open-local-app-seed.sh",
    "local:sam": "./scripts/local-env.sh sam-api",
    "local:build": "bash ./scripts/build-sam.sh",
    "local:verify": "./scripts/local-env.sh verify",
    "infra:synth": "pnpm run infra:synth:dev",
    "infra:synth:dev": "cdk synth --quiet -c stage=dev",
    "infra:synth:prod": "cdk synth --quiet -c stage=prod",
    "infra:diff": "pnpm run infra:diff:dev",
    "infra:diff:dev": "cdk diff -c stage=dev",
    "infra:diff:prod": "cdk diff -c stage=prod",
    "infra:check": "pnpm run typecheck && pnpm test && pnpm run test:contract",
    "infra:deploy:dev": "./scripts/deploy-infrastructure.sh dev",
    "infra:deploy:prod": "./scripts/deploy-infrastructure.sh prod",
    "voice:smoke": "tsx scripts/voice-smoke.ts",
    "rates:smoke": "tsx scripts/check-rate-cache-authorization.ts",
    "voice:env": "tsx scripts/voice-environment.ts",
    "db:migrate": "docker compose run --rm flyway validate migrate",
    "db:build-migrations": "./scripts/build-migrations.sh",
    "test:migrations": "vitest run --config vitest.integration.config.ts tests/integration/flyway.test.ts",
    "wear:build": "./scripts/wear-build.sh"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.103",
    "@aws-amplify/react-native": "^1.3.3",
    "@aws-sdk/client-lambda": "^3.1146.0",
    "@aws-sdk/client-secrets-manager": "^3.1145.0",
    "@expo/vector-icons": "^15.0.0",
    "@formatjs/intl-locale": "4.2.13",
    "@formatjs/intl-pluralrules": "^5.4.6",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "~8.4.7",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "7.18.8",
    "@tanstack/react-query": "^5.90.0",
    "ai": "7.0.127",
    "aws-amplify": "^6.22.1",
    "aws-cdk-lib": "^2.261.0",
    "aws-jwt-verify": "^5.2.1",
    "constructs": "^10.6.0",
    "decimal.js": "^10.6.0",
    "esbuild": "^0.28.1",
    "expo": "~54.0.0",
    "expo-audio": "~1.1.1",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.0",
    "expo-localization": "~17.0.9",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-system-ui": "~6.0.9",
    "i18next": "^26.4.2",
    "idb": "^8.0.0",
    "nativewind": "^4.2.1",
    "pg": "^8.23.1",
    "posthog-js": "^1.399.2",
    "posthog-react-native": "^4.55.0",
    "posthog-react-native-session-replay": "^1.6.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.65.0",
    "react-i18next": "^17.0.15",
    "react-native": "0.81.5",
    "react-native-css-interop": "0.2.6",
    "react-native-get-random-values": "~1.11.0",
    "react-native-mmkv": "^3.3.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.17",
    "tslib": "^2.8.1",
    "uuid": "^11.1.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "19.1.0",
    "aws-cdk": "^2.1130.0",
    "babel-preset-expo": "~54.0.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "react-test-renderer": "19.1.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}

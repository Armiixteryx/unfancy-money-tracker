{
  "expo": {
    "name": "Unfancy Money Tracker",
    "slug": "unfancy-money-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "unfancy-money-tracker",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unfancy.moneytracker"
    },
    "android": {
      "package": "com.unfancy.moneytracker",
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F0"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ]
  }
}

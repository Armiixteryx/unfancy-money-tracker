# Safe local-only defaults. Do not put production credentials in this file.
APP_ENV=local
EXPO_PUBLIC_ENV=local
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001
EXPO_PUBLIC_SYNC_API_URL=http://127.0.0.1:3001
EXPO_PUBLIC_LOCAL_AUTH_EMAIL_URL=http://127.0.0.1:3001/auth/email
# Optional cloud adapter configuration. Leave blank for the local-only loop.
EXPO_PUBLIC_COGNITO_REGION=
EXPO_PUBLIC_COGNITO_CLIENT_ID=

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=unfancy_local
POSTGRES_USER=unfancy_local
POSTGRES_PASSWORD=unfancy_local_only
DATABASE_URL=postgresql://unfancy_local:unfancy_local_only@127.0.0.1:5432/unfancy_local

MAILHOG_SMTP_HOST=127.0.0.1
MAILHOG_SMTP_PORT=1025
MAILHOG_HTTP_URL=http://127.0.0.1:8025

# Optional LocalStack contract-testing services. No AWS credentials are required.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_SERVICES=cognito-idp,apigateway,lambda,secretsmanager,ses,sts

# Keep analytics disabled unless explicitly enabled in a local experiment.
POSTHOG_ENABLED=false
POSTHOG_PROJECT_KEY=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

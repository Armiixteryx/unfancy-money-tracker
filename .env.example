# Safe local-only defaults. Do not put production credentials in this file.
APP_ENV=local
EXPO_PUBLIC_ENV=local
EXPO_PUBLIC_EXCHANGE_RATE_API_URL=

DYNAMODB_PORT=8000
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
SYNC_TABLE_NAME=unfancy-local-sync

# Optional LocalStack contract-testing services. No AWS credentials are required.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_SERVICES=cognito-idp,apigateway,lambda,ses,sts

# Keep analytics disabled unless explicitly enabled in a local experiment.
POSTHOG_ENABLED=false
POSTHOG_PROJECT_KEY=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional voice expense service. Public configuration contains endpoints only.
EXPO_PUBLIC_VOICE_BACKEND=local
EXPO_PUBLIC_VOICE_DEV_API_URL=
EXPO_PUBLIC_VOICE_PROD_API_URL=
EXPO_PUBLIC_VOICE_API_URL=http://localhost:3001
# Backend-only credentials; put actual values in gitignored .env.local.
AI_GATEWAY_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
